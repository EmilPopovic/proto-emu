{
  "verilog.linting.linter": "none",
  "C_Cpp.intelliSenseEngine": "default",
  "clangd.enable": false,
  "direnv.restart.automatic": true,
  
  // Language rules
  "editor.rulers": [100],
  "[markdown]": {
    "editor.rulers": []
  },
  "[systemverilog][json][yaml]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false
  }
}
